{
	admin localhost:2019
}

# ------------------------------------------------------------------------------
# DOMÍNIO 1: CARINA (CCO Videowall, Semáforos e Telemetria de Ambulâncias EVP)
# ------------------------------------------------------------------------------
{$CARINA_DOMAIN:carinanoxfort}.duckdns.org {
	tls {
		dns duckdns {$CARINA_TOKEN:ff528f24-1dd3-4c84-9c12-02b6d9805440}
	}

	log {
		output stdout
		format console
	}

	# Rota Ambulâncias EVP
	handle /amb* {
		reverse_proxy host.docker.internal:2201 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Rota CCO Videowall (React + ECharts + SSE)
	handle /cco* {
		reverse_proxy host.docker.internal:2201 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Rota padrão: Gateway Go da Carina na porta 2201
	handle {
		reverse_proxy host.docker.internal:2201 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}

# ------------------------------------------------------------------------------
# DOMÍNIO 2: NOXFORT MONITOR (Observabilidade Industrial e Incidentes)
# ------------------------------------------------------------------------------
{$MONITOR_DOMAIN:noxfortmonitor}.duckdns.org {
	tls {
		dns duckdns {$MONITOR_TOKEN:2c42c374-2143-4292-93c3-5baccb6446c4}
	}

	log {
		output stdout
		format console
	}

	# WebSocket endpoint para Mosquitto MQTT (WSS)
	@mqtt_ws {
		path /mqtt
	}
	reverse_proxy @mqtt_ws host.docker.internal:9001

	# Ingestão de telemetria e Web UI do Monitor na porta 22100
	reverse_proxy host.docker.internal:22100 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
